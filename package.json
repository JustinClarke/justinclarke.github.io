{
  "name": "justinclarke-github-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc && vite build && node scripts/inject-metadata.js",
    "build:prompt": "node scripts/build-system-prompt.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "screenshots": "node scripts/capture-screenshots.js",
    "screenshots:matrix": "node scripts/capture-screenshots.js --matrix",
    "test": "vitest run",
    "lint": "tsc --noEmit && node scripts/check-tailwind-tokens.mjs && node scripts/check-route-sync.mjs && node scripts/build-system-prompt.mjs --check && eslint . --max-warnings=146"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "description": "Portfolio of Justin Clarke Data Product Engineer. Featuring live F1 telemetry simulation, an interactive terminal, and production-grade data engineering case studies.",
  "author": "Justin Clarke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinClarke/justinclarke.github.io.git"
  },
  "keywords": [],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/JustinClarke/justinclarke.github.io/issues"
  },
  "homepage": "https://github.com/JustinClarke/justinclarke.github.io#readme"
}

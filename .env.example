# Umami analytics public website ID (not a secret). Real values injected via CI.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_WEB3FORMS_KEY=

# Debug logger (src/utils/debug.ts). Set to 1 to print [namespace] trace logs
# to the browser console. Leave empty/off in production.
# Tip: you can also enable it at runtime without rebuilding by running
#   localStorage.debug = '*'   (or 'hero,f1')   in the browser console.
VITE_DEBUG=

# AI Agent proxy URL (Cloudflare Worker endpoint)
VITE_AI_PROXY_URL=https://portfolio-ai.justinclarke.workers.dev
